# Primary: OpenRouter
LLM_API_KEY=your_openrouter_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODELS=openrouter/free
# Fallback: Groq (used on rate-limit / provider errors)
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
# Optional: faster models for simple intents (falls back to LLM_MODELS if empty)
# LLM_MODELS_FAST=
LLM_MAX_TOKENS=900
LLM_MAX_TOKENS_SIMPLE=800
LLM_MAX_HISTORY=10
LLM_MAX_HISTORY_SIMPLE=8
LLM_TOOL_RESULT_CHARS=2000
LLM_PREVIEW_ROWS=15

# Legacy aliases still work if LLM_* above are unset:
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
# GROQ_MODEL_FALLBACK=qwen/qwen3.8-27b

DATA_DIR=./data
SQLITE_PATH=./data/app.db
CORS_ORIGINS=http://localhost:3000
QUERY_ROW_LIMIT=40
QUERY_TIMEOUT_SECONDS=30
